{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saudepratica-gemini",
  "main": "gemini-worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": { "bindings": [ { "name": "QUOTA", "class_name": "DailyMealQuota" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": [ "DailyMealQuota" ] } ]
}