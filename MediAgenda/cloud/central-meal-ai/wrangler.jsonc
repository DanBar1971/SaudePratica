{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saudepratica-refeicoes",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA",
        "class_name": "DailyMealQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DailyMealQuota"
      ]
    }
  ]
}