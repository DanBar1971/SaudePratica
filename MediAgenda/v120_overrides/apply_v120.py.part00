# View flags / file capture, profile-bound and separate from ordinary med photos.
patch(Path('MainActivity.kt'),
    '    private var pendingMedicationPhotoTargetId: String? = null\n',
    '''    private var pendingMedicationPhotoTargetId: String? = null
    private var leafletMedicineId:String?=null
    private var leafletProfileId:String?=null
    private var leafletPhotoFile:File?=null
    private val leafletPdfPicker=registerForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
        if(uri!=null)saveMedicineLeaflet(uri)
        else clearLeafletCapture()
    }
    private val leafletCamera=registerForActivityResult(ActivityResultContracts.TakePicture()) { ok ->
        val source=leafletPhotoFile
        if(ok && source!=null && source.length()>100){
            var pdfFile:File?=null
            try{
                pdfFile=photoToLeafletPdf(source)
                saveMedicineLeaflet(Uri.fromFile(pdfFile))
            }catch(ex:Exception){
                showError("Não foi possível digitalizar a bula: "+(ex.message?:"Erro desconhecido"))
            }finally{
                source.delete(); pdfFile?.delete();leafletPhotoFile=null
            }
        }else{source?.delete();clearLeafletCapture()}
    }
    private fun clearLeafletCapture(){
        leafletMedicineId=null;leafletProfileId=null;leafletPhotoFile=null
    }
    private fun photoToLeafletPdf(source:File):File{
        val options=android.graphics.BitmapFactory.Options().apply {inJustDecodeBounds=true}
        android.graphics.BitmapFactory.decodeFile(source.absolutePath,options)
        require(options.outWidth>0 && options.outHeight>0) {"Fotografia da bula inválida"}
        val scale=(maxOf(options.outWidth,options.outHeight)/1800).coerceAtLeast(1)
        val bitmap=android.graphics.BitmapFactory.decodeFile(source.absolutePath,
            android.graphics.BitmapFactory.Options().apply {inSampleSize=scale})
            ?:error("Não foi possível abrir a fotografia")
        val pdf=android.graphics.pdf.PdfDocument()
        val out=File.createTempFile("bula_digit_", ".pdf",cacheDir)
        try{
            val landscape=bitmap.width>bitmap.height
            val w=if(landscape)842 else 595
            val h=if(landscape)595 else 842
            val page=pdf.startPage(android.graphics.pdf.PdfDocument.PageInfo.Builder(w,h,1).create())
            val usableW=(w-40).toFloat();val usableH=(h-40).toFloat()
            val factor=minOf(usableW/bitmap.width,usableH/bitmap.height)
            val target=android.graphics.RectF((w-bitmap.width*factor)/2f,
                (h-bitmap.height*factor)/2f,(w+bitmap.width*factor)/2f,
                (h+bitmap.height*factor)/2f)
            page.canvas.drawColor(android.graphics.Color.WHITE)
            page.canvas.drawBitmap(bitmap,null,target,android.graphics.Paint(android.graphics.Paint.FILTER_BITMAP_FLAG))
            pdf.finishPage(page)
            out.outputStream().use{pdf.writeTo(it)}
            require(out.length()>100){"O PDF da bula está vazio"}
            return out
        }finally{pdf.close();bitmap.recycle()}
    }
    private fun saveMedicineLeaflet(uri:Uri){
        val id=leafletMedicineId;val profile=leafletProfileId
        if(id.isNullOrBlank()||profile.isNullOrBlank())return
        try{
            val medicines=com.mediagenda.app.data.DataRepository(this,profile).loadMedications()
            val idx=medicines.indexOfFirst{it.id==id}
            require(idx>=0){"O medicamento já não existe neste perfil"}
            val current=medicines[idx]
            val item=com.mediagenda.app.data.HealthDocumentStore(this,profile)
                .add(uri,"Bula · "+current.medication.ifBlank{"Medicamento"})
            medicines[idx]=current.copy(leafletDocumentId=item.id)
            com.mediagenda.app.data.DataRepository(this,profile).saveMedications(medicines)
            Toast.makeText(this,"Bula guardada em PDF nos Documentos Digitais.",Toast.LENGTH_LONG).show()
            if(activeProfileId==profile)showMedication()
        }catch(ex:Exception){showError("Bula não guardada: "+(ex.message?:"Erro"))}
        finally{clearLeafletCapture()}
    }
    private fun chooseLeaflet(id:String,camera:Boolean){
        leafletMedicineId=id;leafletProfileId=activeProfileId
        if(!camera){leafletPdfPicker.launch(arrayOf("application/pdf"));return}
        try{
            val folder=File(cacheDir,"saudepratica_document_scans").apply{mkdirs()}
            val file=File.createTempFile("bula_", ".jpg",folder)
            leafletPhotoFile=file
            leafletCamera.launch(FileProvider.getUriForFile(this,"$packageName.documents",file))
        }catch(ex:Exception){clearLeafletCapture();showError("Câmara indisponível: "+ex.message)}
    }
    private fun openMedicineLeaflet(med:Medication){
        val doc=com.mediagenda.app.data.HealthDocumentStore(this,activeProfileId).all()
            .firstOrNull{it.id==med.leafletDocumentId}
        if(doc==null){showError("Bula não encontrada. Podes anexar o PDF novamente.");return}
        startActivity(Intent(this,DocumentOrientationActivity::class.java)
            .putExtra(DocumentOrientationActivity.PROFILE,activeProfileId)
            .putExtra(DocumentOrientationActivity.GROUP,"documents")
            .putExtra(DocumentOrientationActivity.FILENAME,doc.fileName)
            .putExtra(DocumentOrientationActivity.TITLE,doc.name)
            .putExtra(DocumentOrientationActivity.VIEW_ONLY,true))
    }
''','leaflet capture methods')

