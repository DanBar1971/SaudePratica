"""SaúdePrática v1.9.101: card UX, default med images, secure leaflet PDF storage,
compact agenda and profile-independent preservation of previous medication data.
Patch runs after all v1.9.100 overrides have been applied.
"""
import base64
from pathlib import Path
R=Path('build-src/MediAgenda_Android_v1')
APP=R/'app/src/main/java/com/mediagenda/app'

def patch(path,old,new,label):
    p=APP/path
    s=p.read_text(encoding='utf-8')
    count=s.count(old)
    if label=='medication rounded card' and count==2:
        p.write_text(s.replace(old,new,1),encoding='utf-8')
        return
    if count!=1:raise RuntimeError(f'{label}: anchor count {count}')
    p.write_text(s.replace(old,new,1),encoding='utf-8')

