# Restore image bytes from user-provided photos, unchanged in content, simply optimized.
for src,dst in [('medicine_no_box','medicine_no_box'),('medicine_no_photo','medicine_no_photo')]:
    b64=''.join(part.read_text(encoding='ascii').strip() for part in sorted((Path(__file__).parent/'assets').glob(f'{src}.jpg.b64.part*')))
    out=R/'app/src/main/res/drawable-nodpi'/f'{dst}.jpg'
    out.parent.mkdir(parents=True,exist_ok=True)
    out.write_bytes(base64.b64decode(b64))
print('v1.9.101 medication cards, safety + PDF leaflet + compact agenda patch applied')
