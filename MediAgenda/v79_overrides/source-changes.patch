+    private fun manualIntake(){
+        val meds=DataRepository(this,profileId).loadMedications().sortedBy{it.medication.lowercase()}
+        if(meds.isEmpty()){alert("Regista primeiro o medicamento em Medicação.");return}
+        MaterialAlertDialogBuilder(this).setTitle("Escolher medicamento")
+            .setItems(meds.map{it.medication+" — "+it.dose}.toTypedArray()){_,idx->
+                val med=meds[idx]
+                val fields=LinearLayout(this).apply{orientation=LinearLayout.VERTICAL
+                    setPadding(dp(15),dp(5),dp(15),dp(8))}
+                fields.addView(label("Deixa os campos vazios para registar o momento em que carregas em TOMEI.",13f,color=muted))
+                val day=EditText(this).apply{hint="Data opcional (AAAA-MM-DD)";textSize=16f}
+                val hour=EditText(this).apply{hint="Hora opcional (HH:mm)";textSize=16f}
+                fields.addView(day);fields.addView(hour)
+                val dlg=MaterialAlertDialogBuilder(this).setTitle("Registar "+med.medication)
+                    .setView(fields).setNegativeButton("Cancelar",null)
+                    .setPositiveButton("✓ TOMEI",null).show()
+                dlg.getButton(androidx.appcompat.app.AlertDialog.BUTTON_POSITIVE).setOnClickListener{
+                    val d=day.text.toString().trim();val t=hour.text.toString().trim()
+                    val timestamp=if(d.isEmpty()&&t.isEmpty())System.currentTimeMillis() else
+                        if(d.isEmpty()||t.isEmpty())null else runCatching{
+                            LocalDateTime.of(LocalDate.parse(d),LocalTime.parse(t))
+                                .atZone(ZoneId.systemDefault()).toInstant().toEpochMilli()
+                        }.getOrNull()
+                    if(timestamp==null||timestamp>System.currentTimeMillis()+60000L){
+                        alert("Indica uma data/hora válida não futura, ou deixa ambos os campos vazios.")
+                    }else runCatching{
+                        store.add("intakes",med.medication,mapOf("medication_id" to med.id,
+                            "source" to "registo_manual"),timestamp)
+                    }.onSuccess{dlg.dismiss();refresh()}
+                        .onFailure{alert(it.message?:"Não foi possível guardar a toma.")}
+                }
+            }.setNegativeButton("Cancelar",null).show()
+    }
+
     private fun showIntakeHistory(){
+        body.addView(button("＋ Registar toma manualmente") { manualIntake() })
         val confirmed=runCatching{store.list("intakes")}.getOrElse{
             alert("Erro ao ler tomas confirmadas: "+it.message);emptyList()
         }
