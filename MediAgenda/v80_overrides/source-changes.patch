+    fun districts(context:Context):List<String> {
+        val d=regions(context)
+        return d.keys().asSequence().toList().sortedWith(String.CASE_INSENSITIVE_ORDER)
+    }
+    fun municipalities(context:Context,district:String):List<String> {
+        val array=regions(context).optJSONArray(district) ?: return emptyList()
+        return (0 until array.length()).map{array.optString(it)}.filter{it.isNotBlank()}
+            .sortedWith(String.CASE_INSENSITIVE_ORDER)
+    }
+    fun facilities(district:String,municipality:String):List<Facility> = known.filter{
+        same(it.district,district) && same(it.municipality,municipality)
+    }.sortedBy{it.name}
+    fun normalize(s:String):String = Normalizer.normalize(s,Normalizer.Form.NFD)
+        .replace(Regex("\\p{M}+"),"").lowercase(Locale.ROOT)
+        .replace(Regex("[^a-z0-9]+")," ").trim()
+    private fun same(a:String,b:String) = normalize(a)==normalize(b)
