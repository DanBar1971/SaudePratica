+    /** Pesquisa de unidades com Distrito → Concelho → Unidade, com localização opcional.
+     * A base local é uma lista inicial, não o inventário nacional da ERS.
+     */
+    private fun chooseHealthcareDistrict(onSelected: (String) -> Unit) {
+        val districts = HealthcareCatalog.districts(this)
+        val options = listOf("📍 Usar localização do telemóvel") + districts
+        MaterialAlertDialogBuilder(this).setTitle("1/3 · Escolher distrito ou região")
+            .setItems(options.toTypedArray()) { _, index ->
+                if (index == 0) requestHealthcareGps(onSelected)
+                else chooseHealthcareMunicipality(districts[index-1],onSelected)
+            }.setNegativeButton("Cancelar",null).show()
+    }
+
+    private fun chooseHealthcareMunicipality(district:String,onSelected:(String)->Unit) {
+        val municipalities=HealthcareCatalog.municipalities(this,district)
+        val options=municipalities + "✍️ Escrever concelho manualmente"
+        MaterialAlertDialogBuilder(this).setTitle("2/3 · Concelho de $district")
+            .setItems(options.toTypedArray()) { _, index ->
+                if (index<municipalities.size) chooseHealthcareFacility(district,municipalities[index],onSelected)
+                else {
+                    val field=android.widget.EditText(this).apply{hint="Concelho";setSingleLine(true)}
+                    MaterialAlertDialogBuilder(this).setTitle("Indicar concelho")
+                        .setView(field).setPositiveButton("Continuar") { _,_->
+                            val typed=field.text.toString().trim()
+                            if(typed.isNotBlank())chooseHealthcareFacility(district,typed,onSelected)
+                        }.setNegativeButton("Cancelar",null).show()
+                }
+            }.setNeutralButton("‹ Distrito") { _,_->chooseHealthcareDistrict(onSelected)}
+            .setNegativeButton("Cancelar",null).show()
+    }
+
+    private fun chooseHealthcareFacility(district:String,municipality:String,onSelected:(String)->Unit) {
+        val facilities=HealthcareCatalog.facilities(district,municipality)
+        val options=facilities.map{it.name} + listOf("✍️ Outra unidade (escrever)",
+            "🔎 Consultar registo nacional ERS")
+        val prefs=getSharedPreferences("saudepratica_facility_filter",MODE_PRIVATE)
+        prefs.edit().putString("district",district).putString("municipality",municipality).apply()
+        MaterialAlertDialogBuilder(this)
+            .setTitle("3/3 · $municipality ($district)")
+            .setItems(options.toTypedArray()) { _,index->
+                when(index){
+                    in 0 until facilities.size -> onSelected(facilities[index].name)
+                    facilities.size -> enterHealthcareFacility(municipality,onSelected)
+                    else -> {
+                        openUrl(HealthcareCatalog.ersUrl)
+                        // ERS pesquisa num navegador; a escolha manual continua disponível.
+                    }
+                }
+            }
+            .setNeutralButton("‹ Concelho") { _,_->chooseHealthcareMunicipality(district,onSelected)}
+            .setNegativeButton("Cancelar",null).show()
+    }
+
+    private fun enterHealthcareFacility(municipality:String,onSelected:(String)->Unit) {
+        val field=android.widget.EditText(this).apply {
+            hint="Nome do hospital, clínica, USF ou centro de saúde"
+            setSingleLine(false)
+            setPadding(dp(14),dp(12),dp(14),dp(12))
+        }
+        MaterialAlertDialogBuilder(this).setTitle("Unidade de $municipality")
+            .setView(field).setPositiveButton("Selecionar") { _,_->
+                val name=field.text.toString().trim()
+                if(name.isNotEmpty())onSelected(name)
+            }.setNegativeButton("Cancelar",null).show()
+    }
+
+    private fun requestHealthcareGps(onSelected:(String)->Unit) {
+        val fine=ContextCompat.checkSelfPermission(this,Manifest.permission.ACCESS_FINE_LOCATION)==PackageManager.PERMISSION_GRANTED
+        val coarse=ContextCompat.checkSelfPermission(this,Manifest.permission.ACCESS_COARSE_LOCATION)==PackageManager.PERMISSION_GRANTED
+        if (fine || coarse) chooseHealthcareByGps(onSelected)
+        else {
+            pendingFacilitySelection=onSelected
+            locationPermissionLauncher.launch(arrayOf(Manifest.permission.ACCESS_FINE_LOCATION,
+                Manifest.permission.ACCESS_COARSE_LOCATION))
+        }
+    }
+
+    private fun chooseHealthcareByGps(onSelected:(String)->Unit) {
+        val fine=ContextCompat.checkSelfPermission(this,Manifest.permission.ACCESS_FINE_LOCATION)==PackageManager.PERMISSION_GRANTED
+        val coarse=ContextCompat.checkSelfPermission(this,Manifest.permission.ACCESS_COARSE_LOCATION)==PackageManager.PERMISSION_GRANTED
+        if(!fine && !coarse){chooseHealthcareDistrict(onSelected);return}
+        val client=LocationServices.getFusedLocationProviderClient(this)
+        val cts=CancellationTokenSource()
+        client.getCurrentLocation(Priority.PRIORITY_BALANCED_POWER_ACCURACY,cts.token)
+            .addOnSuccessListener { location ->
+                if(location==null){
+                    Toast.makeText(this,"GPS não conseguiu localizar. Seleciona o distrito manualmente.",Toast.LENGTH_LONG).show()
+                    chooseHealthcareDistrict(onSelected)
+                } else {
+                    Thread {
+                        val locationNames=runCatching {
+                            val addr=Geocoder(this,Locale("pt","PT"))
+                                .getFromLocation(location.latitude,location.longitude,1)?.firstOrNull()
+                            addr?.adminArea.orEmpty() to (addr?.subAdminArea ?: addr?.locality).orEmpty()
+                        }.getOrNull()
+                        runOnUiThread {
+                            val districts=HealthcareCatalog.districts(this)
+                            val district=districts.firstOrNull{
+                                HealthcareCatalog.normalize(it)==HealthcareCatalog.normalize(locationNames?.first.orEmpty()) }
+                            val municipalities=if(district!=null)HealthcareCatalog.municipalities(this,district) else emptyList()
+                            val municipality=municipalities.firstOrNull{
+                                HealthcareCatalog.normalize(it)==HealthcareCatalog.normalize(locationNames?.second.orEmpty()) }
+                            if(district!=null && municipality!=null){
+                                MaterialAlertDialogBuilder(this)
+                                    .setTitle("Localização encontrada")
+                                    .setMessage("Distrito: $district\nConcelho: $municipality\nContinuar para escolher a unidade de saúde?")
+                                    .setPositiveButton("Escolher unidade") { _,_->chooseHealthcareFacility(district,municipality,onSelected)}
+                                    .setNegativeButton("Alterar distrito") { _,_->chooseHealthcareDistrict(onSelected)}.show()
+                            } else {
+                                Toast.makeText(this,"Não foi possível obter distrito e concelho. Escolhe manualmente.",Toast.LENGTH_LONG).show()
+                                chooseHealthcareDistrict(onSelected)
+                            }
+                        }
+                    }.start()
+                }
+            }.addOnFailureListener {
+                Toast.makeText(this,"Erro de localização. Seleciona manualmente.",Toast.LENGTH_LONG).show()
+                chooseHealthcareDistrict(onSelected)
+            }
+    }
