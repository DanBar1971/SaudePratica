+    /** An unconfirmed reminder becomes overdue after a 15-minute grace period.
+     * 'Overdue' is not proof the medication was not actually taken.
+     */
+    fun overdueIntakes(now:Long=System.currentTimeMillis()):List<PersonalHealthRecord> {
+        val completed=list("intakes").mapNotNull{
+            val scheduled=it.fields["scheduled_at"].orEmpty()
+            if(scheduled.isNotBlank())it.fields["medication_id"].orEmpty()+"|"+scheduled else null
+        }.toSet()
+        val deleted=list("deleted_intakes").mapNotNull{
+            val scheduled=it.fields["scheduled_at"].orEmpty()
+            if(scheduled.isNotBlank())it.fields["medication_id"].orEmpty()+"|"+scheduled else null
+        }.toSet()
+        return list("pending_intakes").filter{
+            val time=it.fields["scheduled_at"]?.toLongOrNull()?:it.timestamp
+            time>0L && time<=now-15L*60_000L &&
+                (it.fields["medication_id"].orEmpty()+"|"+time) !in completed &&
+                (it.fields["medication_id"].orEmpty()+"|"+time) !in deleted
+        }
     }
 
     fun emergencyValue(key: String) = emergency.getString(key, "").orEmpty()
